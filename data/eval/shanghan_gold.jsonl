{"clause_id": "SHL_001", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 1, "raw_text": "太陽之為病，脈浮，頭項強痛而惡寒。", "expected_rules": [{"rule_type": "disease_definition_rule", "disease": "太陽病", "conditions": ["脈浮", "頭項強痛", "惡寒"]}]}
{"clause_id": "SHL_180", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 180, "raw_text": "陽明之為病，胃家實是也。", "expected_rules": [{"rule_type": "disease_definition_rule", "disease": "陽明病", "conditions": ["胃家實"]}]}
{"clause_id": "SHL_263", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 263, "raw_text": "少陽之為病，口苦，咽乾，目眩也。", "expected_rules": [{"rule_type": "disease_definition_rule", "disease": "少陽病", "conditions": ["口苦", "咽乾", "目眩"]}]}
{"clause_id": "SHL_273", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 273, "raw_text": "太陰之為病，腹滿而吐，食不下，自利益甚，時腹自痛。若下之，必胸下結鞕。", "expected_rules": [{"rule_type": "disease_definition_rule", "disease": "太陰病", "conditions": ["腹滿", "吐", "食不下", "自利"]}, {"rule_type": "mistreatment_rule", "mistreatment": "下之", "consequence": "胸下結鞕"}]}
{"clause_id": "SHL_281", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 281, "raw_text": "少陰之為病，脈微細，但欲寐也。", "expected_rules": [{"rule_type": "disease_definition_rule", "disease": "少陰病", "conditions": ["脈微細", "但欲寐"]}]}
{"clause_id": "SHL_002", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 2, "raw_text": "太陽病，發熱，汗出，惡風，脈緩者，名為中風。", "expected_rules": [{"rule_type": "pulse_pattern_rule", "pattern": "中風"}]}
{"clause_id": "SHL_003", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 3, "raw_text": "太陽病，或已發熱，或未發熱，必惡寒，體痛，嘔逆，脈陰陽俱緊者，名為傷寒。", "expected_rules": [{"rule_type": "pulse_pattern_rule", "pattern": "傷寒"}]}
{"clause_id": "SHL_004", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 4, "raw_text": "傷寒一日，太陽受之。脈若靜者，為不傳；頗欲吐，若躁煩，脈數急者，為傳也。", "expected_rules": [{"rule_type": "transmission_rule"}]}
{"clause_id": "SHL_185", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 185, "raw_text": "本太陽初得病時，發其汗，汗先出不徹，因轉屬陽明也。", "expected_rules": [{"rule_type": "transmission_rule", "transmission": "轉屬陽明"}]}
{"clause_id": "SHL_012", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 12, "raw_text": "太陽中風，陽浮而陰弱，陽浮者，熱自發，陰弱者，汗自出。嗇嗇惡寒，淅淅惡風，翕翕發熱，鼻鳴乾嘔者，桂枝湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "桂枝湯", "conditions": ["太陽中風", "嗇嗇惡寒", "淅淅惡風", "翕翕發熱", "鼻鳴", "乾嘔"]}]}
{"clause_id": "SHL_013", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 13, "raw_text": "太陽病，頭痛發熱，汗出惡風者，桂枝湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "桂枝湯", "conditions": ["太陽病", "頭痛", "發熱", "汗出", "惡風"]}]}
{"clause_id": "SHL_014", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 14, "raw_text": "太陽病，項背強几几，反汗出惡風者，桂枝加葛根湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "桂枝加葛根湯", "conditions": ["太陽病", "項背強几几", "汗出", "惡風"]}]}
{"clause_id": "SHL_020", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 20, "raw_text": "太陽病，發汗，遂漏不止，其人惡風，小便難，四肢微急，難以屈伸者，桂枝加附子湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "桂枝加附子湯", "conditions": ["太陽病", "惡風", "小便難", "四肢微急"]}]}
{"clause_id": "SHL_031", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 31, "raw_text": "太陽病，項背強几几，無汗惡風，葛根湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "葛根湯", "conditions": ["太陽病", "項背強几几", "無汗", "惡風"]}]}
{"clause_id": "SHL_032", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 32, "raw_text": "太陽與陽明合病者，必自下利，葛根湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "葛根湯", "conditions": ["下利"]}]}
{"clause_id": "SHL_035", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 35, "raw_text": "太陽病，頭痛發熱，身疼腰痛，骨節疼痛，惡風，無汗而喘者，麻黃湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "麻黃湯", "conditions": ["太陽病", "頭痛", "發熱", "身疼", "腰痛", "骨節疼痛", "惡風", "無汗", "喘"]}]}
{"clause_id": "SHL_038", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 38, "raw_text": "太陽中風，脈浮緊，發熱惡寒，身疼痛，不汗出而煩躁者，大青龍湯主之。若脈微弱，汗出惡風者，不可服之。服之則厥逆，筋惕肉瞤，此為逆也。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "大青龍湯", "conditions": ["太陽中風", "脈浮緊", "發熱", "惡寒", "身疼痛", "煩躁"]}, {"rule_type": "contraindication_rule", "prohibition": "不可服"}]}
{"clause_id": "SHL_040", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 40, "raw_text": "傷寒表不解，心下有水氣，乾嘔，發熱而欬，或渴，或利，或噎，或小便不利、少腹滿，或喘者，小青龍湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "小青龍湯", "conditions": ["傷寒", "心下有水氣", "乾嘔", "發熱", "欬"]}]}
{"clause_id": "SHL_061", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 61, "raw_text": "下之後，復發汗，晝日煩躁不得眠，夜而安靜，不嘔，不渴，無表證，脈沉微，身無大熱者，乾薑附子湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "乾薑附子湯", "conditions": ["煩躁", "不得眠", "脈沉微"]}]}
{"clause_id": "SHL_071", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 71, "raw_text": "太陽病，發汗後，大汗出，胃中乾，煩躁不得眠，欲得飲水者，少少與飲之，令胃氣和則愈。若脈浮，小便不利，微熱消渴者，五苓散主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "五苓散", "conditions": ["脈浮", "小便不利", "消渴"]}]}
{"clause_id": "SHL_076", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 76, "raw_text": "發汗吐下後，虛煩不得眠，若劇者，必反覆顛倒，心中懊憹，梔子豉湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "梔子豉湯", "conditions": ["虛煩", "不得眠", "心中懊憹"]}]}
{"clause_id": "SHL_082", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 82, "raw_text": "太陽病發汗，汗出不解，其人仍發熱，心下悸，頭眩，身瞤動，振振欲擗地者，真武湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "真武湯", "conditions": ["發熱", "心下悸", "頭眩", "身瞤動"]}]}
{"clause_id": "SHL_096", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 96, "raw_text": "傷寒五六日，中風，往來寒熱，胸脇苦滿，嘿嘿不欲飲食，心煩喜嘔，或胸中煩而不嘔，或渴，或腹中痛，或脇下痞鞕，或心下悸、小便不利，或不渴、身有微熱，或欬者，小柴胡湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "小柴胡湯", "conditions": ["往來寒熱", "胸脇苦滿", "心煩", "喜嘔"]}]}
{"clause_id": "SHL_103", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 103, "raw_text": "太陽病，過經十餘日，反二三下之，後四五日，柴胡證仍在者，先與小柴胡。嘔不止，心下急，鬱鬱微煩者，為未解也，與大柴胡湯，下之則愈。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "大柴胡湯", "conditions": ["嘔不止", "心下急", "鬱鬱微煩"]}]}
{"clause_id": "SHL_135", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 135, "raw_text": "傷寒六七日，結胸熱實，脈沉而緊，心下痛，按之石鞕者，大陷胸湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "大陷胸湯", "conditions": ["結胸", "心下痛", "按之石鞕"]}]}
{"clause_id": "SHL_154", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 154, "raw_text": "心下痞，按之濡，其脈關上浮者，大黃黃連瀉心湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "大黃黃連瀉心湯", "conditions": ["心下痞", "按之濡"]}]}
{"clause_id": "SHL_161", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 161, "raw_text": "傷寒發汗，若吐若下，解後，心下痞鞕，噫氣不除者，旋覆代赭湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "旋覆代赭湯", "conditions": ["心下痞鞕", "噫氣不除"]}]}
{"clause_id": "SHL_177", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 177, "raw_text": "傷寒脈結代，心動悸，炙甘草湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "炙甘草湯", "conditions": ["脈結代", "心動悸"]}]}
{"clause_id": "SHL_208", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 208, "raw_text": "陽明病，脈遲，雖汗出不惡寒者，其身必重，短氣，腹滿而喘，有潮熱者，此外欲解，可攻裏也。手足濈然汗出者，此大便已鞕也，大承氣湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "大承氣湯", "conditions": ["潮熱", "手足濈然汗出"]}]}
{"clause_id": "SHL_301", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 301, "raw_text": "少陰病，始得之，反發熱，脈沉者，麻黃細辛附子湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "麻黃細辛附子湯", "conditions": ["少陰病", "發熱", "脈沉"]}]}
{"clause_id": "SHL_303", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 303, "raw_text": "少陰病，得之二三日以上，心中煩，不得臥，黃連阿膠湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "黃連阿膠湯", "conditions": ["少陰病", "心中煩", "不得臥"]}]}
{"clause_id": "SHL_306", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 306, "raw_text": "少陰病，下利便膿血者，桃花湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "桃花湯", "conditions": ["少陰病", "下利", "便膿血"]}]}
{"clause_id": "SHL_317", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 317, "raw_text": "少陰病，下利清穀，裏寒外熱，手足厥逆，脈微欲絕，身反不惡寒，其人面色赤，或腹痛，或乾嘔，或咽痛，或利止脈不出者，通脈四逆湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "通脈四逆湯", "conditions": ["少陰病", "下利清穀", "手足厥逆", "脈微欲絕"]}]}
{"clause_id": "SHL_351", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 351, "raw_text": "手足厥寒，脈細欲絕者，當歸四逆湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "當歸四逆湯", "conditions": ["手足厥寒", "脈細欲絕"]}]}
{"clause_id": "SHL_378", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 378, "raw_text": "乾嘔吐涎沫，頭痛者，吳茱萸湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "吳茱萸湯", "conditions": ["乾嘔", "吐涎沫", "頭痛"]}]}
{"clause_id": "SHL_379", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 379, "raw_text": "嘔而發熱者，小柴胡湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "小柴胡湯", "conditions": ["嘔", "發熱"]}]}
{"clause_id": "SHL_095", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 95, "raw_text": "太陽病，發熱汗出者，此為榮弱衛強，故使汗出，欲救邪風者，宜桂枝湯。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "桂枝湯", "conditions": ["太陽病", "發熱", "汗出"]}]}
{"clause_id": "SHL_253", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 253, "raw_text": "陽明病，發熱汗多者，急下之，宜大承氣湯。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "大承氣湯", "conditions": ["發熱", "汗多"]}]}
{"clause_id": "SHL_063", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 63, "raw_text": "發汗後，不可更行桂枝湯，汗出而喘，無大熱者，可與麻黃杏仁甘草石膏湯。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "麻黃杏仁甘草石膏湯", "conditions": ["汗出", "喘", "無大熱"]}, {"rule_type": "contraindication_rule", "prohibition": "不可更行"}]}
{"clause_id": "SHL_016B", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 16, "raw_text": "桂枝本為解肌，若其人脈浮緊，發熱汗不出者，不可與之也。常須識此，勿令誤也。", "expected_rules": [{"rule_type": "contraindication_rule", "prohibition": "不可與"}]}
{"clause_id": "SHL_044", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 44, "raw_text": "太陽病，外證未解，不可下也，下之為逆。", "expected_rules": [{"rule_type": "contraindication_rule", "prohibition": "不可下"}]}
{"clause_id": "SHL_083", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 83, "raw_text": "咽喉乾燥者，不可發汗。", "expected_rules": [{"rule_type": "contraindication_rule", "prohibition": "不可發汗"}]}
{"clause_id": "SHL_084", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 84, "raw_text": "淋家不可發汗，發汗必便血。", "expected_rules": [{"rule_type": "contraindication_rule", "prohibition": "不可發汗"}]}
{"clause_id": "SHL_085", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 85, "raw_text": "瘡家雖身疼痛，不可發汗，汗出則痙。", "expected_rules": [{"rule_type": "contraindication_rule", "prohibition": "不可發汗"}]}
{"clause_id": "SHL_086", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 86, "raw_text": "衄家不可發汗，汗出必額上陷，脈急緊，直視不能眴，不得眠。", "expected_rules": [{"rule_type": "contraindication_rule", "prohibition": "不可發汗"}]}
{"clause_id": "SHL_087", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 87, "raw_text": "亡血家不可發汗，發汗則寒慄而振。", "expected_rules": [{"rule_type": "contraindication_rule", "prohibition": "不可發汗"}]}
{"clause_id": "SHL_058", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 58, "raw_text": "凡病，若發汗，若吐，若下，若亡血，亡津液，陰陽自和者，必自愈。", "expected_rules": [{"rule_type": "prognosis_rule", "prognosis": "必自愈"}]}
{"clause_id": "SHL_295", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 295, "raw_text": "少陰病，惡寒身踡而利，手足逆冷者，不治。", "expected_rules": [{"rule_type": "prognosis_rule", "prognosis": "不治"}]}
{"clause_id": "SHL_296", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 296, "raw_text": "少陰病，吐利躁煩，四逆者死。", "expected_rules": [{"rule_type": "prognosis_rule", "prognosis": "死"}]}
{"clause_id": "SHL_F_GZT", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "formula", "clause_no": null, "raw_text": "桂枝湯方\n桂枝三兩（去皮） 芍藥三兩 甘草二兩（炙） 生薑三兩（切） 大棗十二枚（擘）\n右五味，㕮咀三味，以水七升，微火煮取三升，去滓，適寒溫，服一升。", "expected_rules": [{"rule_type": "formula_composition_rule", "formula": "桂枝湯"}, {"rule_type": "preparation_rule", "formula": "桂枝湯"}]}
{"clause_id": "SHL_F_MHT", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "formula", "clause_no": null, "raw_text": "麻黃湯方\n麻黃三兩（去節） 桂枝二兩（去皮） 甘草一兩（炙） 杏仁七十個（去皮尖）\n右四味，以水九升，先煮麻黃，減二升，去上沫，內諸藥，煮取二升半，去滓，溫服八合。", "expected_rules": [{"rule_type": "formula_composition_rule", "formula": "麻黃湯"}, {"rule_type": "preparation_rule", "formula": "麻黃湯"}]}
{"clause_id": "JGY_XB", "book_title": "金匱要略方論", "subcategory": "金匱", "text_type": "original", "clause_no": null, "raw_text": "胸痹之為病，喘息欬唾，胸背痛，短氣，寸口脈沉而遲，關上小緊數，栝蔞薤白白酒湯主之。", "expected_rules": [{"rule_type": "disease_definition_rule", "disease": "胸痹", "conditions": ["喘息", "欬唾", "胸背痛", "短氣"]}, {"rule_type": "formula_indication_rule", "formula": "栝蔞薤白白酒湯", "conditions": ["喘息", "胸背痛", "短氣"]}]}
{"clause_id": "JGY_WTT", "book_title": "金匱要略方論", "subcategory": "金匱", "text_type": "original", "clause_no": null, "raw_text": "病歷節不可屈伸，疼痛，烏頭湯主之。", "expected_rules": [{"rule_type": "formula_indication_rule", "formula": "烏頭湯", "conditions": ["歷節", "疼痛"]}]}
{"clause_id": "JGY_SB", "book_title": "金匱要略方論", "subcategory": "金匱", "text_type": "original", "clause_no": null, "raw_text": "太陽病，關節疼痛而煩，脈沉而細者，此名濕痹。", "expected_rules": [{"rule_type": "pulse_pattern_rule", "pattern": "濕痹"}]}
{"clause_id": "SHL_009", "book_title": "傷寒論(宋本)", "subcategory": "傷寒", "text_type": "original", "clause_no": 9, "raw_text": "太陽病欲解時，從巳至未上。", "expected_rules": []}
